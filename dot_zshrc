if [[ ! -o interactive ]]; then
  setopt NO_CHECK_JOBS
  export GIT_TERMINAL_PROMPT=0
  return
fi

##### Prompt / theme ##########################################################################
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

##### History #################################################################################
HISTFILE="$HOME/.zhistory"
HISTSIZE=200000
SAVEHIST=100000

setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
setopt HIST_SAVE_BY_COPY
setopt HIST_VERIFY
setopt SHARE_HISTORY

# Zed sessions should not contend for history or block on background jobs and Git prompts.
if [[ "$TERM_PROGRAM" == "zed" ]]; then
  setopt NO_CHECK_JOBS
  unsetopt SHARE_HISTORY
  export GIT_TERMINAL_PROMPT=0
fi

##### Completion and interactive tools ########################################################
zsh_cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
mkdir -p "$zsh_cache_dir"

autoload -Uz compinit
zcompdump="$zsh_cache_dir/zcompdump"
if [[ -n "$zcompdump"(#qN.mh+24) ]]; then
  compinit -i -d "$zcompdump"
else
  compinit -C -i -d "$zcompdump"
fi

zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$zsh_cache_dir/zcompcache"

# Load ZLE-dependent tools only when the shell has a terminal.
if [[ -t 1 ]]; then
  bindkey '^[[A' history-search-backward
  bindkey '^[[B' history-search-forward

  # Bun completions
  [[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"

  if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init zsh)"
    alias cd="z"
  fi

  if command -v fd >/dev/null 2>&1; then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
  fi

  # fzf defines widgets that autosuggestions and syntax highlighting must wrap afterwards.
  if command -v fzf >/dev/null 2>&1; then
    source <(fzf --zsh)
  fi

  if [[ -r /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
    source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
  elif [[ -r /usr/local/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
    source /usr/local/share/zsh-autosuggestions/zsh-autosuggestions.zsh
  fi
fi

##### Aliases and tools #######################################################################
if command -v eza >/dev/null 2>&1; then
  alias ls="eza --icons=always"
fi
alias reset-airdrop="killall sharingd"

[[ -x "$HOME/.claude/local/claude" ]] && alias claude="$HOME/.claude/local/claude"

# Load local secrets (not tracked by chezmoi).
# This includes OPENAI_API_KEY.
if [[ -f "$HOME/.secrets" ]]; then
  source "$HOME/.secrets"
  alias codex-api='printenv OPENAI_API_KEY | codex login --with-api-key'
  alias codex-sub='codex login'
fi

alias python=python3

# dcg: warn if the hook was silently removed from Claude Code settings.
if command -v dcg >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  if [[ -f "$HOME/.claude/settings.json" ]] && \
     ! jq -e '.hooks.PreToolUse[]? | select(.hooks[]?.command | test("dcg$"))' \
       "$HOME/.claude/settings.json" >/dev/null 2>&1; then
    print -P '%F{yellow}[dcg] Hook missing from ~/.claude/settings.json — run: dcg install%f'
  fi
fi

# Syntax highlighting must be sourced after every widget is defined.
if [[ -t 1 ]]; then
  if [[ -r /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
    source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
  elif [[ -r /usr/local/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
    source /usr/local/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
  fi
fi
